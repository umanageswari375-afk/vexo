# Primary AI provider (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Tokens-per-minute budget for the AI agent. Default is 50000.
GEMINI_TPM=50000



# One hidden admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase web API key (Firebase Console -> Project settings -> Your apps -> Web)
# Firebase web config is public; real protection comes from Firestore security rules.
GOOGLE_API_KEY=your_firebase_web_api_key_here
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-FN6RZTHH6M

PORT=3000
