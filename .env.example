WIREFLOW_API_KEY=your_wireflow_api_key_here
WIREFLOW_BASE_URL=https://your-wireflow-endpoint.example.com
WIREFLOW_MODEL=gpt-4o-mini
# Tokens-per-minute limit of your Wireflow plan. Default is 50000.
# Adjust based on your plan if needed.
WIREFLOW_TPM=50000

# One hidden admin account
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# Firebase web API key (Firebase Console -> Project settings -> Your apps -> Web)
# Firebase web config is public; real protection comes from Firestore security rules.
GOOGLE_API_KEY=your_firebase_web_api_key_here
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX

PORT=3000
